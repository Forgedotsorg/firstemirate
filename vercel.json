{
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "https://my-n8n-app.eastus.cloudapp.azure.com/webhook/first-emirates-chat"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
